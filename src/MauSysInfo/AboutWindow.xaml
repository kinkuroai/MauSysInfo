<Window x:Class="MauSysInfo.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Mau SysInfo" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,22,24,20">
        <StackPanel Orientation="Horizontal">
            <Image x:Name="AppIcon" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="AppName" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="AppVersion" Opacity="0.75" Margin="0,2,0,0"
                           AutomationProperties.Name="Version" />
                <TextBlock x:Name="AppAuthor" Opacity="0.75" Margin="0,1,0,0"
                           AutomationProperties.Name="Author" />
            </StackPanel>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Margin="0,18,0,0"
                   Text="Shows what's inside your PC: processor, caches, mainboard and BIOS, memory modules, graphics cards and displays, drives, network adapters and Windows itself, with live clocks and usage." />
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="It only reads information Windows already exposes. It installs no driver and changes nothing on your system." />

        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="4" BorderThickness="1"
                BorderBrush="#80D29922" Background="#1FD29922">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold" Text="Only download Mau SysInfo from the official site:" />
                <LineBreak />
                <Hyperlink x:Name="SiteLink" RequestNavigate="OnSiteLinkNavigate"
                           AutomationProperties.Name="Official site">
                    <Run x:Name="SiteText" />
                </Hyperlink>
                <LineBreak />
                <Run Text="Copies from anywhere else are not legitimate and may have been modified." />
            </TextBlock>
        </Border>

        <TextBlock x:Name="Details" Opacity="0.6" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12" />

        <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="90"
                HorizontalAlignment="Right" Margin="0,20,0,0" />
    </StackPanel>
</Window>
