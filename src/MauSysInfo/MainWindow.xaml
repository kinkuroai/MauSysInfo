<Window x:Class="MauSysInfo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MauSysInfo.ViewModels"
        xmlns:m="clr-namespace:MauSysInfo.Models"
        xmlns:c="clr-namespace:MauSysInfo.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Height="800" Width="1120" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static vm:WindowCommands.SaveReport}" />
        <KeyBinding Key="C" Modifiers="Control+Shift" Command="{x:Static vm:WindowCommands.CopyReport}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static vm:WindowCommands.SaveReport}" Executed="OnSaveReport" />
        <CommandBinding Command="{x:Static vm:WindowCommands.CopyReport}" Executed="OnCopyReport" />
    </Window.CommandBindings>

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12,16,14" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Margin" Value="0,5,0,1" />
        </Style>

        <!-- Card header shared by every block type -->
        <DataTemplate x:Key="CardHeader" DataType="{x:Type m:InfoBlock}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" FontSize="12"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Visibility>
                        <Binding Path="Subtitle" Converter="{x:Static vm:Converters.NotEmptyToVisibility}" />
                    </TextBlock.Visibility>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- Label / value card -->
        <DataTemplate DataType="{x:Type m:FieldsBlock}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" />
                    <ItemsControl ItemsSource="{Binding Fields}" Grid.IsSharedSizeScope="True" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:InfoField}">
                                <Grid Margin="0,3" Background="Transparent" ToolTip="{Binding Note}"
                                      ToolTipService.InitialShowDelay="300">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy value" Click="OnCopyValue" />
                                            <MenuItem Header="Copy line" Click="OnCopyLine" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Secondary}"
                                               Margin="0,0,16,0" MaxWidth="190" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding Meter, Mode=OneWay, TargetNullValue=0}"
                                                     Visibility="{Binding HasMeter, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Live per-thread tiles -->
        <DataTemplate DataType="{x:Type m:ThreadsBlock}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardHeader}" />
                    <ItemsControl ItemsSource="{Binding Threads}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:ThreadTile}">
                                <Border Width="112" Margin="0,0,8,8" Padding="10,7,10,8" CornerRadius="6"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        ToolTip="{Binding CoreLabel}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,0"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding HasKind, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="12" Style="{StaticResource Secondary}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Clock}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        <ProgressBar Style="{StaticResource Meter}" Value="{Binding Usage, Mode=OneWay}" />
                                        <TextBlock Text="{Binding UsageText}" FontSize="11" Style="{StaticResource Secondary}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Benchmark -->
        <Style x:Key="ScoreTile" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinWidth" Value="180" />
        </Style>
        <DataTemplate DataType="{x:Type m:BenchBlock}">
            <StackPanel DataContext="{Binding ViewModel}" d:DataContext="{d:DesignInstance Type=vm:BenchViewModel}">
                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                           Style="{StaticResource Secondary}" />
                <WrapPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource ScoreTile}">
                        <StackPanel>
                            <TextBlock Text="Single thread" Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding SingleScore}" FontSize="30" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ScoreTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}">
                                <Run Text="All threads (" /><Run Text="{Binding ThreadCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <TextBlock Text="{Binding MultiScore}" FontSize="30" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ScoreTile}">
                        <StackPanel>
                            <TextBlock Text="Multi-thread ratio" Style="{StaticResource Secondary}" />
                            <TextBlock Text="{Binding Ratio}" FontSize="30" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <ProgressBar Margin="0,16,0,0" MaxWidth="600" HorizontalAlignment="Stretch" Height="4" MinHeight="4"
                             Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Run benchmark" Style="{DynamicResource AccentButtonStyle}" MinWidth="140"
                            Command="{Binding RunCommand}" />
                    <Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{Binding StressButtonText}" Margin="8,0,0,0" MinWidth="140"
                            Command="{Binding StressCommand}"
                            ToolTip="Loads every thread until you stop it, to check cooling and stability" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Margin="0,12,0,0" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
    <!-- Status line -->
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="16,5,16,6"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource LayerFillColorDefaultBrush}">
        <DockPanel LastChildFill="True">
            <!-- Update status (right) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0" DataContext="{Binding Update}"
                        Background="Transparent" ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True">
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Check for updates now" Command="{Binding CheckNowCommand}" />
                        <MenuItem Header="Check when Mau SysInfo starts" IsCheckable="True"
                                  IsChecked="{Binding CheckOnStartup}" />
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <ProgressBar Width="80" Height="4" MinHeight="4" Margin="0,0,8,0" VerticalAlignment="Center"
                             Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Text}" Style="{StaticResource Secondary}" VerticalAlignment="Center" FontSize="12"
                           AutomationProperties.AutomationId="UpdateStatus" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}">
                    <Hyperlink Command="{Binding RunActionCommand}" AutomationProperties.Name="{Binding ActionText}">
                        <Run Text="{Binding ActionText, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Border>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel DockPanel.Dock="Top" Margin="18,18,12,14" Orientation="Horizontal">
                <Image x:Name="AppIcon" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Mau SysInfo" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,14">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                        Command="{Binding RestartAsAdminCommand}"
                        Visibility="{Binding IsNotElevated, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Drive temperature, wear and power-on hours need administrator rights">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                        <TextBlock Text="Run as administrator" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                        Command="{Binding RefreshCommand}" ToolTip="Read everything again (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                        Command="{x:Static vm:WindowCommands.SaveReport}"
                        ToolTip="Save every page as a text file (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                        <TextBlock Text="Save report…" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,6"
                        Command="{x:Static vm:WindowCommands.CopyReport}"
                        ToolTip="Copy every page to the clipboard, e.g. for a forum post (Ctrl+Shift+C)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                        <TextBlock Text="Copy report" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnAboutClick"
                        ToolTip="What Mau SysInfo does and which version this is">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
                        <TextBlock Text="About" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Margin="6,0"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Pages">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PageViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="4,3">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Width="20" Margin="0,1,12,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page content -->
        <Grid Grid.Column="1" DataContext="{Binding SelectedPage}" d:DataContext="{d:DesignInstance Type=vm:PageViewModel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="24,18,24,10">
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold" />
                <ProgressBar IsIndeterminate="True" Height="3" MinHeight="3" Margin="0,8,0,0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Error}" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Secondary}"
                           Visibility="{Binding Error, Converter={x:Static vm:Converters.NotEmptyToVisibility}}" />
            </StackPanel>

            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="24,4,24,24">
                    <ItemsControl ItemsSource="{Binding WideBlocks}" Focusable="False">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,12" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ColumnBlocks}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:MasonryPanel MinColumnWidth="400" Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding TrailingBlocks}" Focusable="False">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,12,0,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
